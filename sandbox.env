# Sandbox isolation — keeps this stack fully separate from PROD (project "cvat").
# Usage: docker compose --env-file sandbox.env -p cvat_sandbox ... (the -p prefixes
# all containers/volumes/networks with cvat_sandbox_, so PROD's cvat_* are untouched).
COMPOSE_PROJECT_NAME=cvat_sandbox

# PROD's traefik owns host ports 80/443/8080/8090. Sandbox must use others.
# We run the sandbox UI on 8085 (plain HTTP, dev only — reach via SSH tunnel:
#   ssh -L 8085:localhost:8085 <box>   then http://localhost:8085 ).
CVAT_HOST=localhost
# (dev compose serves UI/api on its own ports; see SANDBOX.md for the launch line)
